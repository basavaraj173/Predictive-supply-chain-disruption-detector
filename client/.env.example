# Backend API URL (for FastAPI backend)
# When deploying server on Render/Railway/Fly.io, set this in Vercel to your deployed backend URL:
# NEXT_PUBLIC_API_URL=https://your-fastapi-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL (for live intelligence stream)
# NEXT_PUBLIC_WS_URL=wss://your-fastapi-backend.onrender.com/ws/intelligence
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/intelligence
